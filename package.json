{
  "name": "kopor",
  "version": "2.0.0",
  "private": true,
  "description": "Kopor: offline-first business book with credit, cash, stock, osusu groups, invoices, payments, staff roles and an AI assistant.",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "dev": "vite",
    "build": "tsc -b && vite build && node tools/licenses.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:db": "node tests/db/rls.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "check": "npm run lint && npm run knip && npm run typecheck && npm run test && npm run test:db && npm run build && npm run size && npm run test:e2e",
    "android:sync": "npm run build && npx cap sync android",
    "test:a11y": "node tools/a11y.mjs",
    "test:crawl": "node tests/e2e/crawl.mjs",
    "knip": "knip --no-progress",
    "size": "node tools/size-budget.mjs",
    "typecheck:server": "npx -y deno@2.5.4 check supabase/functions/*/index.ts"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "8.2.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@point-of-sale/receipt-printer-encoder": "^4.0.1",
    "@sentry/browser": "11.9.0",
    "@supabase/supabase-js": "^2.46.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "cmdk": "^1.1.1",
    "dexie": "4.4.7",
    "dexie-react-hooks": "^1.1.7",
    "driver.js": "^1.9.0",
    "i18next": "^23.16.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "1.61.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.3",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tesseract.js": "^6.0.1",
    "vaul": "^1.1.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@electric-sql/pglite": "^0.2.14",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.0.0",
    "globals": "^17.13.0",
    "knip": "5.88.1",
    "playwright-core": "^1.48.2",
    "supabase": "2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
